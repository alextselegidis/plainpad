#!/bin/bash

# Subshells keep a failing step from leaving the working directory behind.

echo "➜ Install Composer Dependencies"
[ -d server/vendor ] || (cd server && composer install)

echo "➜ Install NPM Dependencies"
[ -d client/node_modules ] || (cd client && npm install)

echo "➜ Start The CRA Dev Server"
(cd client && BROWSER=none npm start) &

echo "➜ Listen To Incoming Requests"
php-fpm
